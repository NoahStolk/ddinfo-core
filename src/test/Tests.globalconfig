is_global = true

global_level = 10

# Avoid constant arrays as arguments.
dotnet_diagnostic.CA1861.severity = none

# Identifiers should not contain underscores.
dotnet_diagnostic.CA1707.severity = none

# Consider calling ConfigureAwait on the awaited task. Every TUnit assertion is awaited, and tests
# run without a synchronization context, so this only adds noise.
dotnet_diagnostic.CA2007.severity = none

# "password" detected here, make sure this is not a hard-coded credential. These are fixture values
# for the encryption round-trip tests, not real credentials.
dotnet_diagnostic.S2068.severity = none

# Use a stronger hashing algorithm. The tests verify MD5 hashes because the replay file format
# stores them; the algorithm is dictated by the game, not chosen here.
dotnet_diagnostic.S4790.severity = none
