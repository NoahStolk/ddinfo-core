<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="Current">

	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup Label="Runtime dependencies">
		<PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12"/>
	</ItemGroup>

	<ItemGroup Label="Test dependencies">
		<PackageVersion Include="JetBrains.Annotations" Version="2026.2.0"/>
		<PackageVersion Include="TUnit" Version="1.87.12"/>
	</ItemGroup>

	<ItemGroup Label="Static code analysis">
		<GlobalPackageReference Include="Nullable.Extended.Analyzer" Version="1.19.0"/>
		<GlobalPackageReference Include="Roslynator.Analyzers" Version="5.0.1"/>
		<GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.36.0.15337"/>
		<GlobalPackageReference Include="StyleCop.Analyzers" Version="1.3.180"/>
	</ItemGroup>

</Project>
